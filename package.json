{
  "name": "stacknav",
  "displayName": "Stack Navigator",
  "description": "Navigate GitHub stacked pull requests from the VS Code status bar.",
  "icon": "media/icon.png",
  "version": "0.1.0",
  "publisher": "sonmai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonmai/stacknav.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "stacknav", "title": "Stack Navigator", "icon": "media/activity-bar.svg" }
      ]
    },
    "views": {
      "stacknav": [
        { "id": "stacknav.overview", "name": "Stack Navigator", "contextualTitle": "Stack Review Overview" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "stacknav.refreshOverview", "when": "view == stacknav.overview", "group": "navigation" }
      ]
    },
    "commands": [
      {
        "command": "stacknav.refreshOverview",
        "title": "Stack Navigator: Refresh Review Overview",
        "icon": "$(refresh)"
      },
      {
        "command": "stacknav.load",
        "title": "Stack Navigator: Load Stack for Current PR"
      },
      {
        "command": "stacknav.loadUrl",
        "title": "Stack Navigator: Load Stack from PR URL\u2026"
      },
      {
        "command": "stacknav.up",
        "title": "Stack Navigator: Up"
      },
      {
        "command": "stacknav.down",
        "title": "Stack Navigator: Down"
      },
      {
        "command": "stacknav.select",
        "title": "Stack Navigator: Select PR\u2026"
      },
      {
        "command": "stacknav.refresh",
        "title": "Stack Navigator: Refresh"
      },
      {
        "command": "stacknav.first",
        "title": "Stack Navigator: Go to First Layer"
      },
      {
        "command": "stacknav.selectStack",
        "title": "Stack Navigator: Select Stack\u2026"
      },
      {
        "command": "stacknav.selectRepository",
        "title": "Stack Navigator: Select Repository\u2026"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run clean && npm run compile && node --test out/test/*.test.js",
    "package:vsix": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.6.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "extensionKind": [
    "workspace"
  ]
}
